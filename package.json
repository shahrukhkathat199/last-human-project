{
  "name": "last-human-project",
  "version": "1.0.0",
  "description": "Last Human on Earth animated short",
  "scripts": {
    "build": "remotion bundle src/index.ts out/bundle.js",
    "render": "remotion render src/index.ts LastHumanShort out/last-human.mp4 --codec h264 --crf 16 --scale=1.3333333333333333 --timeout=300000",
    "render:cloud": "remotion render src/index.ts LastHumanShort out/preview.mp4 --gl=angle --concurrency=4 --crf=23",
    "preview": "remotion preview src/index.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@remotion/three": "^4.0.0",
    "postprocessing": "^6.39.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/tailwind": "^4.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.160.0",
    "typescript": "^5.0.0"
  }
}
